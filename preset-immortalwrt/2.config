# ======================== 【1.LuCI核心 精简优化，剔除冗余编译依赖】 ========================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_LUCI_JSMIN=y                     # JS压缩，节省运行内存
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
# 删除无用full/light冲突包，不额外冗余luci-lib垃圾依赖

# ======================== 【2.常用APP 瘦身，剔除可弃项】 ========================
CONFIG_PACKAGE_luci-app-dawn=y                        # 802.11r/k/v漫游，替换usteer
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-firewall=y
# 【优化】删掉 nlbwmon带宽监控(常驻耗内存，需要后续opkg离线安装)
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-zerotier=y

# ======================== 【新增：目标功能插件：MosDNS去广告+Github加速 | zram防OOM | TurboACC网络优化】 ========================
# MosDNS 全屋DNS去广告+自定义host实现Github劫持加速（CR6609最优，替代ADGH/HomeProxy）
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-i18n-mosdns-zh_Hans=y

# ZRAM 256M内存刚需，内存压缩交换，杜绝长时间运行OOM死机
CONFIG_PACKAGE_luci-app-zram=y
CONFIG_PACKAGE_zram-swap=y

# TurboACC：MTK硬件NAT+BBR优化、QoS优化、流加速配套
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_turboacc=y

# ======================== 【3.SmartDNS 上游DNS防污染，配合MosDNS分层解析】 ========================
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh_Hans=y

# ======================== 【主题】 ========================
CONFIG_PACKAGE_luci-theme-argon=y

# ======================== 【4.802.11 k/v/r + WiFi6 内核开关不动，原厂MT7915D必备】 ========================
CONFIG_MAC80211_RRM=y
CONFIG_MAC80211_FT=y
CONFIG_MAC80211_ROAMING=y

# ======================== 【MT7915D WiFi6无线驱动 完整保留缺一不可】 ========================
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-ieee80211=y
CONFIG_PACKAGE_ieee80211-utils=y
CONFIG_PACKAGE_kmod-mt76=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y

# ======================== 【WPAD 全功能WPA3/802.11ax/802.11krv 固定配置】 ========================
CONFIG_PACKAGE_wpad-openssl=y
# 必须取消wpad-basic，编译时自动冲突禁用
# CONFIG_PACKAGE_wpad-basic=n
CONFIG_WPAD_80211R=y
CONFIG_WPAD_80211K=y
CONFIG_WPAD_80211V=y
CONFIG_WPAD_80211AX=y
CONFIG_WPAD_WPA3=y

# ======================== 【调试工具：精简，只保留刚需，砍掉多余调试】 ========================
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_hostapd-utils=y
# 若极度缺闪存可注释上面两个，后续opkg安装

# ======================== 【MT7621硬件转发+TCP优化 稳定性核心必选】 ========================
CONFIG_PACKAGE_kmod-mtk-flow-offload=y
CONFIG_NF_CONNTRACK_OFFLOAD=y
CONFIG_NETIF_FLOW_OFFLOAD=y
CONFIG_TCP_CONG_BBR=y

# ======================== 【额外稳定性补充内核配置（新增，提升长期挂机）】 ========================
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_CONGESTION_BBR=y        # 默认BBR拥塞算法
CONFIG_IPV6=y
CONFIG_PACKAGE_kmod-ipt-offload=y     # iptables硬件卸载，降低CPU占用
CONFIG_PACKAGE_busybox-nproc=y

