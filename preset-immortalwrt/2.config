# Collections 集合包
# CONFIG_PACKAGE_luci is not set          # LuCI 主界面框架
CONFIG_PACKAGE_luci-light=y             # LuCI 轻量级版本

# Modules 模块包
CONFIG_PACKAGE_luci-base=y              # LuCI 基础模块
CONFIG_LUCI_JSMIN=y                     # 启用 JavaScript 压缩
CONFIG_LUCI_LANG_zh_Hans=y              # 启用简体中文语言支持
CONFIG_PACKAGE_luci-compat=y            # LuCI 兼容性模块
CONFIG_PACKAGE_luci-lua-runtime=y       # Lua 运行时支持
CONFIG_PACKAGE_luci-mod-admin-full=y    # 完整管理模块
CONFIG_PACKAGE_luci-mod-network=y       # 网络配置模块
CONFIG_PACKAGE_luci-mod-status=y        # 状态显示模块
CONFIG_PACKAGE_luci-mod-system=y        # 系统管理模块

# Applications 应用程序包
CONFIG_PACKAGE_luci-app-dawn=y                        # DAWN 802.11k/v/r 漫游优化（已启用）
CONFIG_PACKAGE_luci-app-argon-config=y               # Argon主题配置工具
CONFIG_PACKAGE_luci-app-autoreboot=y                  # 自动重启计划(已启用)
CONFIG_PACKAGE_luci-app-ddns=y                       # 动态DNS客户端
CONFIG_PACKAGE_luci-app-firewall=y                   # 防火墙配置界面
CONFIG_PACKAGE_luci-app-nlbwmon=y                    # 网络带宽监控
CONFIG_PACKAGE_luci-app-opkg=y                       # OPKG包管理器界面
CONFIG_PACKAGE_luci-app-upnp=y                       # UPnP端口映射
CONFIG_PACKAGE_luci-app-zerotier=y                    # ZeroTier虚拟网络(已启用)

# Themes 主题包
CONFIG_PACKAGE_luci-theme-argon=y                     # Argon主题

# ========== 内核层 802.11k/r 支持 ==========
CONFIG_MAC80211_RRM=y
CONFIG_MAC80211_FT=y
CONFIG_MAC80211_ROAMING=y

# ========== 无线驱动通用支持（适配多数网卡，ath10k/mt76/rtl88xx） ==========
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-ieee80211=y
CONFIG_PACKAGE_ieee80211-utils=y
CONFIG_PACKAGE_kmod-mt76=y

# ========== 802.11k/v/r 核心依赖：全功能wpad（必须禁用wpad-basic/mini） ==========
CONFIG_PACKAGE_wpad-openssl=y

# ========== 无线调试工具（可选，方便后续验证） ==========
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_hostapd-utils=y
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_usteer=y

# ========== 802.11v 补充配置（hostapd 启用BSS切换） ==========
CONFIG_PACKAGE_hostapd-openssl=y
CONFIG_HOSTAPD_80211V=y
CONFIG_HOSTAPD_80211R=y
CONFIG_HOSTAPD_80211K=y
