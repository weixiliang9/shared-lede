# ======================== 核心LuCI配置（适配MT7621，轻量且完整） ========================
# 优先启用luci主框架，替代light+full的冲突组合
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y              # LuCI基础模块
CONFIG_LUCI_JSMIN=y                     # JS压缩（减少内存占用）
CONFIG_LUCI_LANG_zh_Hans=y              # 简体中文（适配国内使用）
CONFIG_PACKAGE_luci-compat=y            # 兼容性模块（兼容老插件）
CONFIG_PACKAGE_luci-lua-runtime=y       # Lua运行时（必选）
CONFIG_PACKAGE_luci-mod-admin-full=y    # 完整管理模块（MT7621性能足够）
CONFIG_PACKAGE_luci-mod-network=y       # 网络配置（必选）
CONFIG_PACKAGE_luci-mod-status=y        # 状态显示（必选）
CONFIG_PACKAGE_luci-mod-system=y        # 系统管理（必选）

# ======================== 核心应用（802.11k/v/r+实用工具） ========================
CONFIG_PACKAGE_luci-app-dawn=y                        # DAWN漫游（MT7915D首选，删除usteer）
CONFIG_PACKAGE_luci-app-argon-config=y               # Argon主题配置
CONFIG_PACKAGE_luci-app-autoreboot=y                  # 自动重启
CONFIG_PACKAGE_luci-app-ddns=y                       # DDNS（动态域名）
CONFIG_PACKAGE_luci-app-firewall=y                   # 防火墙（必选）
CONFIG_PACKAGE_luci-app-nlbwmon=y                    # 带宽监控（可选，可删除）
CONFIG_PACKAGE_luci-app-opkg=y                       # OPKG包管理（必选，便于后续装插件）
CONFIG_PACKAGE_luci-app-upnp=y                       # UPnP（影音设备适配）
CONFIG_PACKAGE_luci-app-zerotier=y                    # ZeroTier（虚拟组网）

# ======================== 主题 ========================
CONFIG_PACKAGE_luci-theme-argon=y                     # Argon主题（和配置工具配套）

# ======================== 内核层802.11k/v/r支持（MT7915D必选） ========================
CONFIG_MAC80211_RRM=y                  # 802.11k邻居报告
CONFIG_MAC80211_FT=y                   # 802.11r快速漫游
CONFIG_MAC80211_ROAMING=y              # 漫游基础支持

# ======================== MT7915D无线驱动（核心，缺一不可） ========================
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-ieee80211=y
CONFIG_PACKAGE_ieee80211-utils=y
CONFIG_PACKAGE_kmod-mt76=y             # MT76通用驱动
CONFIG_PACKAGE_kmod-mt7915e=y          # MT7915D PCIe驱动
CONFIG_PACKAGE_kmod-mt7915-firmware=y  # MT7915D固件（无此配置无线无法启动）

# ======================== wpad配置（802.11k/v/r核心依赖） ========================
CONFIG_PACKAGE_wpad-openssl=y          # 全功能wpad（必须禁用wpad-basic）
CONFIG_WPAD_80211R=y                   # 802.11r（WPAD前缀，替代HOSTAPD）
CONFIG_WPAD_80211K=y                   # 802.11k
CONFIG_WPAD_80211V=y                   # 802.11v
CONFIG_WPAD_80211AX=y                  # Wi-Fi 6（MT7915D必加）
CONFIG_WPAD_WPA3=y                     # WPA3加密（MT7915D支持）

# ======================== 调试/工具（可选，便于排查问题） ========================
CONFIG_PACKAGE_iw=y                    # 无线调试（必选，验证802.11k/v/r）
CONFIG_PACKAGE_hostapd-utils=y         # hostapd工具（验证漫游配置）

# ======================== MT7621硬件加速（必加，释放性能） ========================
CONFIG_PACKAGE_kmod-mtk-flow-offload=y # MT7621硬件转发
CONFIG_NF_CONNTRACK_OFFLOAD=y
CONFIG_NETIF_FLOW_OFFLOAD=y
CONFIG_TCP_CONG_BBR=y                  # BBR加速
