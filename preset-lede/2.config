# CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk is not set # DiskMan 包含 lsblk 工具（未启用）
# CONFIG_PACKAGE_luci-app-diskman_INCLUDE_mdadm is not set # DiskMan 包含 mdadm 磁盘阵列工具（未启用）
