# CONFIG_PACKAGE_luci-app-clash is not set         # Clash 科学上网（未启用）
# CONFIG_PACKAGE_luci-app-commands is not set      # 自定义命令执行（未启用）
# CONFIG_PACKAGE_luci-app-cshark is not set        # 网络抓包工具（未启用）
CONFIG_PACKAGE_luci-app-dawn=y                     # DAWN 802.11k/v/r 漫游优化（已启用）
# DDNS 动态域名解析
CONFIG_PACKAGE_luci-app-ddns=y
# CONFIG_PACKAGE_luci-app-ddns-go is not set       # DDNS-GO 动态域名解析（未启用）
# CONFIG_PACKAGE_luci-app-ddnsto is not set        # DDNSTO 内网穿透（未启用）
