# ======================== 核心集合配置 ========================
# 启用 LuCI Web 管理界面核心包
CONFIG_PACKAGE_luci=y

# ======================== 基础模块 ========================
# LuCI 基础核心组件
CONFIG_PACKAGE_luci-base=y
# 启用 LuCI 中文语言包
CONFIG_LUCI_LANG_zh-cn=y
# LuCI 向后兼容组件（适配旧版API）
CONFIG_PACKAGE_luci-compat=y
# LuCI Lua 运行时环境
CONFIG_PACKAGE_luci-lua-runtime=y
# LuCI 完整的管理员后台模块
CONFIG_PACKAGE_luci-mod-admin-full=y

# ======================== 应用插件 ========================
# CONFIG_PACKAGE_luci-app-accesscontrol is not set # 访问控制（上网时间控制）(未启用)
# CONFIG_PACKAGE_luci-app-acme is not set          # ACME 证书自动申请（未启用）
# CONFIG_PACKAGE_luci-app-adblock is not set       # AD广告屏蔽（未启用）
# CONFIG_PACKAGE_luci-app-adbyby-plus is not set   # ADByby Plus 广告过滤（未启用）
# CONFIG_PACKAGE_luci-app-adguardhome is not set   # AdGuard Home 广告过滤/ DNS 解析（未启用）
# CONFIG_PACKAGE_luci-app-adguardhome_INCLUDE_binary is not set # 为 AdGuard Home 包含二进制可执行文件（需先启用主插件） 
# CONFIG_PACKAGE_luci-app-advanced is not set      # 高级系统设置（未启用）
# CONFIG_PACKAGE_luci-app-advanced-reboot is not set # 高级重启（重启到不同分区/固件）（未启用）
# CONFIG_PACKAGE_luci-app-ahcp is not set          # AHCP 协议支持（未启用）
# CONFIG_PACKAGE_luci-app-airplay2 is not set      # AirPlay2 投屏（未启用）
# CONFIG_PACKAGE_luci-app-aliddns is not set       # 阿里DDNS（未启用）
# CONFIG_PACKAGE_luci-app-alist is not set         # 阿里云盘/OneDrive 等网盘挂载（未启用）
# CONFIG_PACKAGE_luci-app-aliyundrive-fuse is not set # 阿里云盘 FUSE 挂载（未启用）
# CONFIG_PACKAGE_luci-app-aliyundrive-webdav is not set # 阿里云盘 WebDAV 服务（未启用）
# CONFIG_PACKAGE_luci-app-amule is not set         # aMule 电驴下载（未启用）
# CONFIG_PACKAGE_luci-app-argon-config is not set  # Argon 主题配置（未启用）
# Argone 主题配置（新版Argon）
CONFIG_PACKAGE_luci-app-argone-config=y
# CONFIG_PACKAGE_luci-app-aria2 is not set         # Aria2 下载工具（未启用）
# ARP绑定（IP/MAC 绑定，防ARP欺骗）
CONFIG_PACKAGE_luci-app-arpbind=y
# CONFIG_PACKAGE_luci-app-asterisk is not set      # Asterisk 软电话（未启用）
# CONFIG_PACKAGE_luci-app-attendedsysupgrade is not set # 在线系统升级（未启用）
# 自动重启（定时重启路由器）
CONFIG_PACKAGE_luci-app-autoreboot=y
# CONFIG_PACKAGE_luci-app-baidupcs-web is not set  # 百度网盘 PCS Web（未启用）
# CONFIG_PACKAGE_luci-app-bcp38 is not set         # BCP38 网络防护（未启用）
