# CONFIG_PACKAGE_luci-app-e2guardian is not set    # E2Guardian 网页过滤（未启用）
# CONFIG_PACKAGE_luci-app-easymesh is not set      # EasyMesh 组网（未启用）
# CONFIG_PACKAGE_luci-app-eqos is not set          # 基于IP的QOS限速（未启用）
# 文件助手（文件管理）
CONFIG_PACKAGE_luci-app-fileassistant=y
# CONFIG_PACKAGE_luci-app-filebrowser is not set   # FileBrowser 文件管理器（未启用）
# 文件传输（上传/下载文件）
CONFIG_PACKAGE_luci-app-filetransfer=y
# 防火墙管理
CONFIG_PACKAGE_luci-app-firewall=y
