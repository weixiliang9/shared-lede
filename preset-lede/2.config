# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server is not set # SSR Plus 包含 SSR Libev 服务端（未启用）
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan is not set # SSR Plus 包含 Trojan 协议（未启用）
# CONFIG_PACKAGE_luci-app-ssrserver-python is not set # Python 版 SSR 服务端（未启用）
# CONFIG_PACKAGE_luci-app-statistics is not set     # 流量统计（未启用）
# CONFIG_PACKAGE_luci-app-store is not set         # LuCI 应用商店（未启用）
# CONFIG_PACKAGE_luci-app-syncdial is not set      # 多拨叠加（未启用）
# CONFIG_PACKAGE_luci-app-tinyproxy is not set     # TinyProxy 代理（未启用）
# CONFIG_PACKAGE_luci-app-transmission is not set  # Transmission 下载工具（未启用）
# CONFIG_PACKAGE_luci-app-travelmate is not set    # TravelMate 自动切换WiFi（未启用）
# CONFIG_PACKAGE_luci-app-ttyd is not set          # TTYD 网页终端（未启用）
# Turbo ACC 网络加速
CONFIG_PACKAGE_luci-app-turboacc=y
# Turbo ACC 包含硬件转发（Offloading）
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
# Turbo ACC 包含 BBR 拥塞控制算法
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
# Turbo ACC 包含 PDNSD DNS 缓存
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_PDNSD=y
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_DNSFORWARDER is not set # Turbo ACC 包含 DNSFORWARDER（未启用）
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_DNSPROXY is not set # Turbo ACC 包含 DNSPROXY（未启用）
# CONFIG_PACKAGE_luci-app-udpxy is not set         # UDProxy 组播转单播（未启用）
# CONFIG_PACKAGE_luci-app-uhttpd is not set        # uHTTPd 网页服务器（未启用）
# CONFIG_PACKAGE_luci-app-unblockmusic is not set  # 解锁网易云音乐（旧版）（未启用）
# CONFIG_PACKAGE_luci-app-unblockmusic_INCLUDE_UnblockNeteaseMusic_Go is not set # 解锁网易云音乐 GO 版（未启用）
# CONFIG_PACKAGE_luci-app-unblockmusic_INCLUDE_UnblockNeteaseMusic_NodeJS is not set # 解锁网易云音乐 NodeJS 版（未启用）
# CONFIG_PACKAGE_luci-app-unblockneteasemusic is not set # 解锁网易云音乐（新版）（未启用）
# CONFIG_PACKAGE_luci-app-unbound is not set       # Unbound DNS 解析器（未启用）
# UPnP 自动端口映射
CONFIG_PACKAGE_luci-app-upnp=y
# CONFIG_PACKAGE_luci-app-usb-printer is not set   # USB 打印机共享（未启用）
# CONFIG_PACKAGE_luci-app-usbmodem is not set      # USB 调制解调器（未启用）
# CONFIG_PACKAGE_luci-app-uugamebooster is not set # UU 游戏加速器（未启用）
# CONFIG_PACKAGE_luci-app-v2ray-server is not set  # V2ray 服务端（未启用）
# CONFIG_PACKAGE_luci-app-verysync is not set      # 微力同步（未启用）
# CONFIG_PACKAGE_luci-app-vlmcsd is not set        # KMS 激活服务器（未启用）
# CONFIG_PACKAGE_luci-app-vnstat is not set        # VNStat 流量统计（未启用）
# CONFIG_PACKAGE_luci-app-vpnbypass is not set     # VPN 旁路（未启用）
# CONFIG_PACKAGE_luci-app-vsftpd is not set        # Vsftpd FTP 服务器（未启用）
# CONFIG_PACKAGE_luci-app-watchcat is not set      # 看门狗（断线重连/重启）（未启用）
# CONFIG_PACKAGE_luci-app-webadmin is not set      # Web 管理增强（未启用）
# CONFIG_PACKAGE_luci-app-webdav is not set        # WebDAV 服务（未启用）
# CONFIG_PACKAGE_luci-app-wifischedule is not set  # WiFi 定时开关（未启用）
# CONFIG_PACKAGE_luci-app-wireguard is not set     # WireGuard VPN（未启用）
# CONFIG_PACKAGE_luci-app-wol is not set           # WOL 网络唤醒（未启用）
# CONFIG_PACKAGE_luci-app-wrtbwmon is not set      # 带宽监控（未启用）
# CONFIG_PACKAGE_luci-app-xlnetacc is not set      # 迅雷快鸟（未启用）
CONFIG_PACKAGE_luci-app-zerotier=y                 # ZeroTier 虚拟局域网（已启用）

# ======================== 主题配置 ========================
# CONFIG_PACKAGE_luci-theme-argon is not set        # Argon 主题（未启用）
# CONFIG_PACKAGE_luci-theme-argon-mod is not set    # Argon 主题修改版（未启用）
# Argone 主题（新版Argon）
CONFIG_PACKAGE_luci-theme-argone=y
# CONFIG_PACKAGE_luci-theme-atmaterial_new is not set # ATMaterial 新主题（未启用）
# Bootstrap 主题（默认主题）
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-theme-design is not set       # Design 主题（未启用）
# CONFIG_PACKAGE_luci-theme-ifit is not set         # iFit 主题（未启用）
# CONFIG_PACKAGE_luci-theme-material is not set     # Material 主题（未启用）
# CONFIG_PACKAGE_luci-theme-netgear is not set      # Netgear 风格主题（未启用）
# CONFIG_PACKAGE_luci-theme-opentopd is not set     # OpenTopd 主题（未启用）
# CONFIG_PACKAGE_luci-theme-tomato is not set       # Tomato 风格主题（未启用）

# ======================== 协议支持 ========================
# CONFIG_PACKAGE_luci-proto-3g is not set           # 3G 网络协议（未启用）
# CONFIG_PACKAGE_luci-proto-3x is not set           # 3X 网络协议（未启用）
# CONFIG_PACKAGE_luci-proto-bonding is not set      # 网卡绑定协议（未启用）
# CONFIG_PACKAGE_luci-proto-ipip is not set         # IPIP 隧道协议（未启用）
# IPv6 协议支持
CONFIG_PACKAGE_luci-proto-ipv6=y
# CONFIG_PACKAGE_luci-proto-mbim is not set         # MBIM 调制解调器协议（未启用）
# CONFIG_PACKAGE_luci-proto-modemmanager is not set # ModemManager 调制解调器管理（未启用）
# CONFIG_PACKAGE_luci-proto-ncm is not set          # NCM 调制解调器协议（未启用）
# CONFIG_PACKAGE_luci-proto-openconnect is not set  # OpenConnect 协议（未启用）
# PPP 协议支持（PPPoE/PPTP 等）
CONFIG_PACKAGE_luci-proto-ppp=y
# CONFIG_PACKAGE_luci-proto-qmi is not set          # QMI 调制解调器协议（未启用）
# CONFIG_PACKAGE_luci-proto-relay is not set        # 中继协议（未启用）
# CONFIG_PACKAGE_luci-proto-vpnc is not set         # VPNC 协议（未启用）
# CONFIG_PACKAGE_luci-proto-vxlan is not set        # VXLAN 隧道协议（未启用）
# CONFIG_PACKAGE_luci-proto-wireguard is not set    # WireGuard 协议（未启用）

# ======================== 库文件 ========================
# CONFIG_PACKAGE_luci-lib-dracula is not set        # Dracula 配色库（未启用）
# CONFIG_PACKAGE_luci-lib-httpclient is not set     # HTTP 客户端库（未启用）
# CONFIG_PACKAGE_luci-lib-httpprotoutils is not set # HTTP 协议工具库（未启用）
# IP 地址处理库
CONFIG_PACKAGE_luci-lib-ip=y
# CONFIG_PACKAGE_luci-lib-ipkg is not set           # IPKG 包管理库（未启用）
# CONFIG_PACKAGE_luci-lib-iptparser is not set      # IPTables 解析库（未启用）
# CONFIG_PACKAGE_luci-lib-jquery-1-4 is not set     # jQuery 1.4 库（未启用）
# CONFIG_PACKAGE_luci-lib-json is not set           # JSON 处理库（未启用）
# JSONC 处理库（支持注释的JSON）
CONFIG_PACKAGE_luci-lib-jsonc=y
# CONFIG_PACKAGE_luci-lib-luaneightbl is not set    # Lua 八位字节库（未启用）
# Nixio 系统调用库
CONFIG_PACKAGE_luci-lib-nixio=y
# CONFIG_PACKAGE_luci-lib-nixio_notls is not set    # Nixio 无TLS版本（未启用）
# CONFIG_PACKAGE_luci-lib-nixio_axtls is not set    # Nixio + axTLS 库（未启用）
# CONFIG_PACKAGE_luci-lib-nixio_cyassl is not set   # Nixio + CyaSSL 库（未启用）
# Nixio + OpenSSL 库
CONFIG_PACKAGE_luci-lib-nixio_openssl=y
# CONFIG_PACKAGE_luci-lib-px5g is not set           # PX5G 加密库（未启用）
# CONFIG_PACKAGE_luci-lib-taskd is not set          # 任务管理库（未启用）
# CONFIG_PACKAGE_luci-lib-xterm is not set          # XTerm 终端库（未启用）

CONFIG_PACKAGE_hostapd-utils=y
CONFIG_HOSTAPD_WPA3=y
CONFIG_HOSTAPD_80211R=y
CONFIG_HOSTAPD_80211K=y
CONFIG_HOSTAPD_80211V=y
CONFIG_HOSTAPD_80211AX=y # 若有MT7615等AX芯片则启用，AC芯片可忽略

# MT7621 硬件转发专属（必加）
CONFIG_PACKAGE_kmod-mtk-flow-offload=y
# 原有Turbo ACC依赖保留
CONFIG_NF_CONNTRACK_OFFLOAD=y
CONFIG_NETIF_FLOW_OFFLOAD=y
CONFIG_TCP_CONG_BBR=y
CONFIG_PACKAGE_pdnsd=y
